POSTGRES_DB=proctoring
POSTGRES_USER=proctoring
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://proctoring:local-development-only@db:5432/proctoring
VITE_API_BASE_URL=http://localhost:8000/api/v1
JWT_SECRET_KEY=local-development-secret-change-before-deployment-000000000000
JWT_ISSUER=northstar-assess
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
